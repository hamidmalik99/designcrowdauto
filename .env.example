# Copy to .env for local runs. In GitHub, add each as an Actions secret instead.

# Google Sheet (service account JSON pasted as one line, or a path to the .json file)
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Search: set ONE of these
BRAVE_API_KEY=
SERPER_API_KEY=

# Google PageSpeed Insights (free key; works without one at low volume)
PAGESPEED_API_KEY=

# Optional: Hunter.io fallback (generic role addresses only)
HUNTER_API_KEY=

# Brevo (transactional API key). SENDER_EMAIL must be a verified sender on an authenticated domain.
BREVO_API_KEY=
SENDER_EMAIL=ali@hamidbuilds.dev
REPLY_TO_EMAIL=

# Unsubscribe: Apps Script web-app /exec URL + shared HMAC secret (long random string)
UNSUBSCRIBE_BASE_URL=
UNSUBSCRIBE_SECRET=
# Optional mailto for the List-Unsubscribe header, e.g. youraddress+unsubscribe@gmail.com
UNSUBSCRIBE_MAILTO=

# Gmail read-only (from scripts/gmail_auth.py)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Shown in the crawler's User-Agent
BOT_INFO_URL=https://hamidbuilds.dev
